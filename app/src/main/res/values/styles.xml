<?xml version="1.0" encoding="utf-8"?>
<resources>


    <style name="TabItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/bg_tab_normal</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">12sp</item>
    </style>


    <style name="TabItemSelecionado">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/bg_tab_selecionado</item>
        <item name="android:textColor">#141522</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotaoFaculdade">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="backgroundTint">#A2B8E9</item>
        <item name="strokeColor">#7E95C8</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="rippleColor">#8CA5D5</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">#1F2A56</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BotaoCurso">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:background">@drawable/bg_button_curso</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingTop">16dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingBottom">16dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="FotoPerfilCircular">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
        <item name="strokeWidth">3dp</item>
        <item name="strokeColor">#0C031F</item>
    </style>

</resources>