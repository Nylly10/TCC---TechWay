<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/perfil"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#01112C"
    android:orientation="vertical"
    tools:context=".nylly.Perfil">

    <!-- BARRA SUPERIOR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="30dp"
        android:paddingEnd="15dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/logo_description" />

        <EditText
            android:id="@+id/barraPesquisa"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="15dp"
            android:hint="@string/buscar"
            android:textColorHint="#777777"
            android:textSize="16sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/fundo_pesquisa"
            android:inputType="text"
            android:autofillHints="none" />

    </LinearLayout>


    <!-- LINHA DIVISÓRIA -->
    <View
        android:layout_width="350dp"
        android:layout_height="1dp"
        android:background="@color/white"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />


    <!-- ÁREA ROLÁVEL -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <!-- CARD DO PERFIL -->
        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="@drawable/fundo_arredondado"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- TÍTULO -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Seu Perfil"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="22sp" />


            <!-- LINHA DIVISÓRIA -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />


            <!-- FOTO E BOAS-VINDAS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/fotoPerfil"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:contentDescription="Foto de perfil"
                        android:scaleType="centerCrop"
                        android:src="@drawable/chatgpt_image_22_de_ago__de_2026__12_52_58"
                        app:shapeAppearanceOverlay="@style/FotoPerfilCircular" />


                </LinearLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="15dp"
                    android:text="Olá, Bem-Vindo!"
                    android:textColor="@color/black"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    />

            </LinearLayout>


            <!-- LINHA DIVISÓRIA -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/black"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- DADOS DO USUÁRIO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- NOME -->
                <TextView
                    android:id="@+id/txtNome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nome:"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvNome"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Nome completo"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- DATA DE NASCIMENTO -->
                <TextView
                    android:id="@+id/txtDataNascimento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Data de Nascimento:"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvDataNascimento"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="01/01/2000"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- E-MAIL -->
                <TextView
                    android:id="@+id/txtEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="E-mail:"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="ana@gmail.com"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- TELEFONE -->
                <TextView
                    android:id="@+id/txtTelefone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telefone:"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="(00)11111-2222"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- LOCALIZAÇÃO -->
                <TextView
                    android:id="@+id/txtLocalização"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Localização:"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tvLocalizacao"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/edit_text"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="Rua, cidade, estado"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <!-- GÊNERO -->
                <TextView
                    android:id="@+id/txtGenro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gênero:"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="17sp" />

                <Spinner
                    android:id="@+id/spinnerGenero"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/edit_text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp" />

                <!-- BOTÃO ALTERAR DADOS -->
                <Button
                    android:id="@+id/btnAlterarDados"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:backgroundTint="#A78DD9"
                    android:text="Alterar dados"
                    android:textColor="#211247"
                    android:textStyle="bold"
                    android:layout_marginTop="30dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>