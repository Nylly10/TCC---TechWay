<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101728"
    android:padding="18dp"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!--  Essa é a logo do app-->
                <LinearLayout
                    android:layout_width="49dp"
                    android:layout_height="45dp"
                    android:padding="11dp"
                    android:orientation="horizontal"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/logo">
                </LinearLayout>

                <!-- Toda a parte da barra de pesquisa o Container e a barra       -->
                <LinearLayout
                    android:id="@+id/conteiner_Barra2"
                    android:layout_width="match_parent"
                    android:layout_height="41dp"
                    android:layout_marginLeft="25dp"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.SearchView

                        android:id="@+id/barra_pesquisa2"
                        android:layout_width="280dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/barra_arredondada"
                        android:gravity="center"
                        android:padding="11dp"
                        app:iconifiedByDefault="false"
                        app:queryBackground="@null"
                        app:queryHint="Buscar" />
                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:background="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTeste"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Teste" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipResultado"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resultado" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAreas"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Áreas em TI" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCursos"
                            style="@style/Widget.MaterialComponents.Chip.Choice"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cursos" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="2dp"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="9dp"
                android:background="#FFFFFF" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Faculdades"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card_recomendacoes"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Recomendações"
                        android:textColor="#6A4FD6"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:id="@+id/listaFaculdades"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnUsp"
                            style="@style/BotaoFaculdade"
                            android:text="USP" />

                        <Button
                            android:id="@+id/btnUnifesp"
                            style="@style/BotaoFaculdade"
                            android:text="Unifesp" />

                        <Button
                            android:id="@+id/btnFatecRap"
                            style="@style/BotaoFaculdade"
                            android:text="FATEC" />

                        <Button
                            android:id="@+id/btnAnhembi"
                            style="@style/BotaoFaculdade"
                            android:text="Universidade Anhembi Morumbi" />

                        <Button
                            android:id="@+id/btnFatec"
                            style="@style/BotaoFaculdade"
                            android:text="Fatec" />

                        <Button
                            android:id="@+id/btnUnicamp"
                            style="@style/BotaoFaculdade"
                            android:text="Unicamp" />

                        <Button
                            android:id="@+id/btnFiap"
                            style="@style/BotaoFaculdade"
                            android:text="Fiap" />


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
