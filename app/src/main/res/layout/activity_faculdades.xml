<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#141522">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/topBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="48dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/logo"
                    android:contentDescription="Logo TechWay" />

                <EditText
                    android:id="@+id/edtBuscar"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_field"
                    android:drawableEnd="@android:drawable/ic_menu_search"
                    android:hint="Buscar"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:textColor="#141522"
                    android:textColorHint="#8A8496"
                    android:textSize="14sp" />

            </LinearLayout>


            <HorizontalScrollView
                android:id="@+id/scrollTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tabTeste"
                        style="@style/TabItem"
                        android:text="Teste" />

                    <TextView
                        android:id="@+id/tabResultado"
                        style="@style/TabItem"
                        android:text="Resultado" />

                    <TextView
                        android:id="@+id/tabFaculdades"
                        style="@style/TabItemSelecionado"
                        android:text="Faculdades" />

                    <TextView
                        android:id="@+id/tabExtra"
                        style="@style/TabItem"
                        android:text="Cursos" />

                </LinearLayout>
            </HorizontalScrollView>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="32dp"
                android:paddingEnd="24dp"
                android:paddingBottom="32dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Faculdades"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_card_recomendacoes"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="24dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Recomendações"
                        android:textColor="#6A4FD6"
                        android:textSize="18sp"
                        android:textStyle="bold" />


                    <LinearLayout
                        android:id="@+id/listaFaculdades"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="vertical">

                        <Button
                            android:id="@+id/btnUsp"
                            style="@style/BotaoFaculdade"
                            android:text="USP" />

                        <Button
                            android:id="@+id/btnUnifesp"
                            style="@style/BotaoFaculdade"
                            android:text="Unifesp" />

                        <Button
                            android:id="@+id/btnFatecRap"
                            style="@style/BotaoFaculdade"
                            android:text="FATEC" />

                        <Button
                            android:id="@+id/btnAnhembi"
                            style="@style/BotaoFaculdade"
                            android:text="Universidade Anhembi Morumbi" />

                        <Button
                            android:id="@+id/btnFatec"
                            style="@style/BotaoFaculdade"
                            android:text="Fatec" />

                        <Button
                            android:id="@+id/btnUnicamp"
                            style="@style/BotaoFaculdade"
                            android:text="Unicamp" />

                        <Button
                            android:id="@+id/btnFiap"
                            style="@style/BotaoFaculdade"
                            android:text="Fiap" />


                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>