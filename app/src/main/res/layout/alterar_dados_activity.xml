<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alterarDados"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#01112C"
    android:padding="18dp"
    android:orientation="vertical"
    tools:context=".nylly.AlterarDados">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!--  Essa é a logo do app-->
        <LinearLayout
            android:layout_width="49dp"
            android:layout_height="45dp"
            android:padding="11dp"
            android:orientation="horizontal"
            android:layout_marginStart="9dp"
            android:background="@drawable/logo">
        </LinearLayout>

        <!-- Toda a parte da barra de pesquisa o Container e a barra       -->
        <LinearLayout
            android:id="@+id/conteiner_Barra2"
            android:layout_width="match_parent"
            android:layout_height="41dp"
            android:layout_marginLeft="25dp"
            android:orientation="horizontal">

            <androidx.appcompat.widget.SearchView
                android:id="@+id/barra_pesquisa2"
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:background="@drawable/barra_arredondada"
                android:gravity="center"
                android:padding="11dp"
                app:iconifiedByDefault="false"
                app:queryBackground="@null"
                app:queryHint="Buscar" />
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:background="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <com.google.android.material.chip.ChipGroup
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTeste"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teste" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipResultado"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resultado" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAreas"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Áreas em TI" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCursos"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cursos" />

            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginStart="9dp"
        android:layout_marginEnd="9dp"
        android:background="#FFFFFF" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="30dp"
            android:background="@drawable/fundo_arredondado"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Seu Perfil"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/black"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">


                <!-- FOTO E BOTÃO -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/fotoPerfil"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:contentDescription="Foto de perfil"
                        android:src="@drawable/chatgpt_image_22_de_ago__de_2026__12_52_58"
                        app:shapeAppearanceOverlay="@style/FotoPerfilCircular" />

                    <Button
                        android:id="@+id/btn_alterarFoto"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#A78DD9"
                        android:text="Alterar Foto"
                        android:textColor="#211247"

                        android:textStyle="bold"
                        app:strokeWidth="0.5dp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/black"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />


            <!-- 1°coluna -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <!-- 2°coluna -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">


                    <TextView
                        android:id="@+id/txtNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp" />

                    <EditText
                        android:id="@+id/edtNome"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="Nome completo"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data de Nascimento:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp"  />

                    <EditText
                        android:id="@+id/edtDataNascimento"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="ex: 01/01/2000"
                        android:inputType="date"/>



                    <TextView
                        android:id="@+id/txtEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-mail:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp"  />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="ex: ana@gmail.com"
                        android:inputType="textEmailAddress"/>

                    <TextView
                        android:id="@+id/txtTelefone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefone:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp" />

                    <EditText
                        android:id="@+id/edtTelefone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="ex: 11 88888-9999"
                        android:inputType="phone"/>



                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Localização:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp"  />

                    <EditText
                        android:id="@+id/edtLocalizacao"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="rua, cidade, estado"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gênero:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp"  />

                    <Spinner
                        android:id="@+id/spinnerGenero"
                        android:layout_width="130dp"
                        android:layout_height="35dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/edit_text" />

                    <Button
                        android:id="@+id/btnSalvarDados"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="15dp"
                        android:backgroundTint="#A78DD9"
                        android:text="Salvar dados"
                        android:textColor="#211247"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


</LinearLayout>