<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/alterarDados"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#01112C"
    android:orientation="vertical"
    tools:context=".nylly.AlterarDados">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="30dp"
        android:paddingEnd="15dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/logo_description"/>

        <EditText
            android:id="@+id/barraPesquisa"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="15dp"
            android:hint="@string/buscar"
            android:textColorHint="#777777"
            android:textSize="16sp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:background="@drawable/fundo_pesquisa"
            android:inputType="text"
            android:autofillHints="none"/>

    </LinearLayout>

    <View
        android:layout_width="350dp"
        android:layout_height="1dp"
        android:background="@color/white"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="30dp"
            android:background="@drawable/fundo_arredondado"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Seu Perfil"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/black"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">


                <!-- FOTO E BOTÃO -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/fotoPerfil"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:contentDescription="Foto de perfil"
                        android:src="@drawable/chatgpt_image_22_de_ago__de_2026__12_52_58"
                        app:shapeAppearanceOverlay="@style/FotoPerfilCircular" />

                    <Button
                        android:id="@+id/btn_alterarFoto"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:backgroundTint="#A78DD9"
                        android:text="Alterar Foto"
                        android:textColor="#211247"

                        android:textStyle="bold"
                        app:strokeWidth="0.5dp" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/black"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />


            <!-- 1°coluna -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">


                <!-- 2°coluna -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="8dp">


                    <TextView
                        android:id="@+id/txtNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp" />

                    <EditText
                        android:id="@+id/edtNome"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="Nome completo"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Data de Nascimento:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp"  />

                    <EditText
                        android:id="@+id/edtDataNascimento"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="ex: 01/01/2000"
                        android:inputType="date"/>



                    <TextView
                        android:id="@+id/txtEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="E-mail:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp"  />

                    <EditText
                        android:id="@+id/edtEmail"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="ex: ana@gmail.com"
                        android:inputType="textEmailAddress"/>

                    <TextView
                        android:id="@+id/txtTelefone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Telefone:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp" />

                    <EditText
                        android:id="@+id/edtTelefone"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="ex: 11 88888-9999"
                        android:inputType="phone"/>



                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Localização:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp"  />

                    <EditText
                        android:id="@+id/edtLocalizacao"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:textSize="14sp"
                        android:background="@drawable/edit_text"
                        android:layout_marginBottom="12dp"
                        android:hint="rua, cidade, estado"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Gênero:"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textSize="17sp"  />

                    <Spinner
                        android:id="@+id/spinnerGenero"
                        android:layout_width="130dp"
                        android:layout_height="35dp"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/edit_text" />

                    <Button
                        android:id="@+id/btnSalvarDados"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="15dp"
                        android:backgroundTint="#A78DD9"
                        android:text="Salvar dados"
                        android:textColor="#211247"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


</LinearLayout>