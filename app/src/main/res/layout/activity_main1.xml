<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="25dp"
    android:background="@drawable/fundo_tela"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="22dp"
        android:layout_marginTop="56dp"
        android:orientation="vertical"
        android:background="@drawable/campo_arredondado_exterior"
        android:elevation="8dp"
        android:outlineAmbientShadowColor="#E8DFEA">

        <ImageView
            android:id="@+id/logoTechWay"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:src="@drawable/Logo_TechWay"
            android:scaleType="fitCenter"/>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cadastre-se"
            android:textAlignment="center"
            android:textSize="21dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:paddingBottom="12dp"/>

        <EditText
            android:id="@+id/editname"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Nome"
            android:inputType="textPersonName"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/campo_arredondado"/>

        <EditText
            android:id="@+id/editemail"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/campo_arredondado"/>

        <EditText
            android:id="@+id/editsenha"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Senha"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/campo_arredondado"/>

        <EditText
            android:id="@+id/editconfsenha"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Confirme a senha"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/campo_arredondado"/>
    </LinearLayout>




</FrameLayout>