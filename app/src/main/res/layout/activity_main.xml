<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10182D"
    android:id="@+id/main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--  Essa é a logo do app-->
            <LinearLayout
                android:layout_width="49dp"
                android:layout_height="45dp"
                android:padding="11dp"
                android:orientation="horizontal"
                android:layout_marginStart="9dp"
                android:background="@drawable/logo">
            </LinearLayout>

            <!-- Toda a parte da barra de pesquisa o Container e a barra       -->
            <LinearLayout
                android:id="@+id/conteiner_Barra2"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:layout_marginLeft="25dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/barra_pesquisa2"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/barra_arredondada"
                    android:gravity="center"
                    android:padding="11dp"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@null"
                    app:queryHint="Buscar" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:background="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTeste"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teste" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipResultado"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resultado" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAreas"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Áreas em TI" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCursos"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cursos" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:background="#FFFFFF" />


        <!-- ============================================= -->
        <!-- TÍTULO -->
        <!-- ============================================= -->

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="Teste Vocacional"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"/>


        <!-- ============================================= -->
        <!-- CARD DA PERGUNTA -->
        <!-- ============================================= -->

        <LinearLayout
            android:id="@+id/cardPergunta"
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/bg_vocacional_card">


            <!-- PERGUNTA -->

            <TextView
                android:id="@+id/txtPergunta"
                android:layout_width="match_parent"
                android:layout_height="86dp"
                android:gravity="center"
                android:text="Gosto de criar interfaces visualmente organizadas e agradáveis."
                android:textColor="#25253A"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>


            <!-- CONCORDO TOTALMENTE -->

            <TextView
                android:id="@+id/opcao1"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Concordo totalmente"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>


            <!-- CONCORDO -->

            <TextView
                android:id="@+id/opcao2"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Concordo"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>


            <!-- NEUTRO -->

            <TextView
                android:id="@+id/opcao3"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Neutro"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>


            <!-- DISCORDO -->

            <TextView
                android:id="@+id/opcao4"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Discordo"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>


            <!-- DISCORDO TOTALMENTE -->

            <TextView
                android:id="@+id/opcao5"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_option"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:text="○  Discordo totalmente"
                android:textColor="#45454D"
                android:textStyle="bold"
                android:textSize="13sp"/>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- NAVEGAÇÃO -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnAnterior"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="32sp"/>


            <ProgressBar
                android:id="@+id/progresso"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:max="18"
                android:progress="1"
                android:progressTint="#7654D9"
                android:backgroundTint="#E9E4F2"/>


            <TextView
                android:id="@+id/btnProximo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="›"
                android:textColor="#FFFFFF"
                android:textSize="32sp"/>

        </LinearLayout>


        <!-- NÚMERO DA PERGUNTA -->

        <TextView
            android:id="@+id/txtNumeroPergunta"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="1 de 18"
            android:textColor="#FFFFFF"
            android:textSize="11sp"/>

    </LinearLayout>

</ScrollView>