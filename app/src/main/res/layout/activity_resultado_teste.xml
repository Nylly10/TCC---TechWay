<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10182D"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!--  Essa é a logo do app-->
            <LinearLayout
                android:layout_width="49dp"
                android:layout_height="45dp"
                android:padding="11dp"
                android:orientation="horizontal"
                android:layout_marginStart="9dp"
                android:background="@drawable/logo">
            </LinearLayout>

            <!-- Toda a parte da barra de pesquisa o Container e a barra       -->
            <LinearLayout
                android:id="@+id/conteiner_Barra2"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:layout_marginLeft="25dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.SearchView

                    android:id="@+id/barra_pesquisa2"
                    android:layout_width="280dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/barra_arredondada"
                    android:gravity="center"
                    android:padding="11dp"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@null"
                    app:queryHint="Buscar" />
            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:background="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <com.google.android.material.chip.ChipGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTeste"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teste" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipResultado"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resultado" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAreas"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Áreas em TI" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCursos"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cursos" />

                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="2dp"
            android:layout_marginStart="9dp"
            android:layout_marginEnd="9dp"
            android:background="#FFFFFF" />


        <!-- ============================================= -->
        <!-- TÍTULO -->
        <!-- ============================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="Teste Vocacional"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="20sp"/>


        <!-- ============================================= -->
        <!-- CARD DO RESULTADO -->
        <!-- ============================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="430dp"
            android:layout_marginTop="6dp"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:background="@drawable/bg_vocacional_card">


            <!-- TÍTULO RESULTADO -->

            <TextView
                android:id="@+id/txtResultado"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="Resultado"
                android:textColor="#7654D9"
                android:textStyle="bold"
                android:textSize="20sp"/>


            <!-- GRÁFICO -->

            <com.example.techwaytcc.manu.ResultadoGraficoView
                android:id="@+id/graficoResultado"
                android:layout_width="match_parent"
                android:layout_height="245dp"
                android:layout_marginTop="8dp"/>


            <!-- ÁREA PRINCIPAL -->

            <TextView
                android:id="@+id/txtAreaPrincipal"
                android:layout_width="match_parent"
                android:layout_height="85dp"
                android:gravity="center"
                android:text="Sua maior afinidade é com Design UI/UX."
                android:textColor="#7654D9"
                android:textStyle="bold"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>

        </LinearLayout>


        <!-- ============================================= -->
        <!-- REFAZER TESTE -->
        <!-- ============================================= -->

        <LinearLayout
            android:id="@+id/btnRefazer"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_result_button">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="Gostaria de refazer o teste?"
                android:textColor="#7654D9"
                android:textSize="13sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="↻"
                android:textColor="#7654D9"
                android:textSize="34sp"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>